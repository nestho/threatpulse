generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articles  Article[]
}

model Category {
  id          String    @id @default(cuid())
  nameEn      String
  nameFa      String
  slug        String    @unique
  description String?
  color       String    @default("#2563eb")
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Source {
  id          String    @id @default(cuid())
  name        String
  type        String    // website | rss | twitter | telegram | other
  url         String?
  handle      String?   // for twitter/telegram username or channel
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique

  // English
  titleEn       String
  excerptEn     String?
  contentEn     String

  // Persian
  titleFa       String?
  excerptFa     String?
  contentFa     String?

  coverImage    String?
  status        String    @default("draft") // draft | published
  views         Int       @default(0)
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  sourceId      String?
  source        Source?   @relation(fields: [sourceId], references: [id])

  tags          String?   // comma-separated

  @@index([status, publishedAt])
  @@index([slug])
}